</div>

<!-- Script pour déclencher les animations au scroll -->
<script>
document.addEventListener('DOMContentLoaded', function() {
// Fonction pour vérifier si un élément est visible dans la viewport
function isElementInViewport(el) {
    const rect = el.getBoundingClientRect();
    return (
        rect.top <= (window.innerHeight || document.documentElement.clientHeight) * 0.75 &&
        rect.bottom >= 0
    );
}

// Cible la section 'Pourquoi nous?'
const whyUsSection = document.querySelector('.why-us-section');

// Fonction pour déclencher l'animation
function handleScrollAnimation() {
    if (isElementInViewport(whyUsSection) && !whyUsSection.classList.contains('animate')) {
        whyUsSection.classList.add('animate');
        
        // Assurer que les animations fonctionnent même sur mobile
        const benefitCards = document.querySelectorAll('.benefit-card');
        benefitCards.forEach((card, index) => {
            // Réinitialiser les styles pour forcer une nouvelle animation
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            
            // Appliquer les animations avec un délai progressif
            setTimeout(() => {
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            }, 700 + (index * 200)); // Délai progressif
        });
        
        // Animation du bouton de téléchargement
        const downloadContainer = document.querySelector('.download_container');
        if (downloadContainer) {
            downloadContainer.style.opacity = '0';
            downloadContainer.style.transform = 'translateY(20px)';
            
            setTimeout(() => {
                downloadContainer.style.opacity = '1';
                downloadContainer.style.transform = 'translateY(0)';
            }, 1300); // Après le dernier benefit
        }
    }
}

// Vérifier la position initiale
handleScrollAnimation();

// Ajouter l'écouteur d'événements pour le scroll
window.addEventListener('scroll', handleScrollAnimation);
});
</script>
