<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vanilla Pay International</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');
        
        body {
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }
        
        .hero-section {
            background-image: linear-gradient(rgba(29, 24, 50, 0.5), rgba(29, 24, 50, 0.5)), url('/assets/images/pexels-mikhail-nilov-7534804\ 1.png');
            background-size: cover;
            background-position: center;
            min-height: 100vh;
            width: 100%;
        }
        
        .logo-container, .menu-container {
            background-color: #1D1832;
            height: 100px;
            display: flex;
            align-items: center;
        }
        
        .logo-container {
            width: 100%;
            max-width: 450px;
            border-top-right-radius: 50px;
            border-bottom-right-radius: 50px;
            padding-left: 10%;
        }
        
        .nav-container {
            display: flex;
            align-items: center;
            padding-top: 30px;
            width: 100%;
            position: relative;
        }
        
        .menu-container {
            border-radius: 60px;
            margin-left: auto;
            margin-right: 10%;
            padding: 0 1.5rem;
            min-width: 850px;
        }
        
        .menu-container div {
            font-size: 1.2rem;
        }
        
        .menu-container .flex .md\:space-x-8 {
            margin-left: 1rem;
            margin-right: 1rem;
        }
        
        .hero-content {
            margin-top: 8vh;
        }
        
        .portfolio-button {
            margin-top: 2rem;
            display: inline-flex;
            align-items: center;
            padding: 0.5rem 0.5rem 0.5rem 1.5rem;
            height: 85px;
            border-radius: 9999px;
        }
        
        .portfolio-button span {
            font-size: 1.1rem;
            padding: 0 1rem;
            align-items: center;
        }
        
        .icon-container {
            width: 50px;
            height: 50px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 50%;
            padding: 0;
        }
        
        .portfolio-button svg {
            height: 1rem;
            width: 1rem;
            display: block;
        }
        
        .mobile-menu-button {
            display: none;
            background: none;
            border: none;
            color: white;
            font-size: 28px;
            cursor: pointer;
            position: absolute;
            right: 20px;
            top: 35px;
            z-index: 50;
        }
        
        /* Media Queries */
        @media (max-width: 1280px) {
            .menu-container {
                min-width: 700px;
            }
        }
        
        @media (max-width: 1024px) {
            .nav-container {
                flex-direction: column;
            }
            
            .logo-container {
                max-width: 90%;
                width: 90%;
                margin: 0 auto;
                border-radius: 30px;
                justify-content: center;
                padding-left: 0;
            }
            
            .menu-container {
                margin: 20px auto;
                width: 90%;
                min-width: auto;
                max-width: 90%;
            }
            
            .hero-content {
                margin-left: 5% !important;
            }
        }
        
        @media (max-width: 768px) {
            .mobile-menu-button {
                display: block;
            }
            
            .nav-container {
                padding-top: 15px;
            }
            
            .logo-container {
                height: 80px;
                justify-content: center;
                padding: 0;
                z-index: 40;
            }
            
            .menu-container {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 0;
                overflow: hidden;
                opacity: 0;
                transition: opacity 0.3s ease, height 0s 0.3s;
                border-radius: 0;
                margin: 0;
                padding: 100px 20px 40px;
                z-index: 30;
            }
            
            .menu-container.active {
                height: 100vh;
                opacity: 1;
                transition: opacity 0.3s ease;
            }
            
            .menu-container .flex {
                flex-direction: column;
                align-items: center;
                justify-content: flex-start;
                height: 100%;
            }
            
            .menu-container .flex > div {
                margin: 15px 0;
            }
            
            .hero-content {
                margin-left: 0 !important;
                padding: 0 20px;
                align-items: center;
                text-align: center;
            }
            
            .hero-content h1 {
                font-size: 2.5rem;
                text-align: center;
            }
            
            .portfolio-button {
                height: 70px;
                margin: 2rem auto;
            }
            
            .icon-container {
                width: 45px;
                height: 45px;
            }
        }
        
        @media (max-width: 480px) {
            .logo-container img {
                height: 50px;
            }
            
            .hero-content h1 {
                font-size: 2rem;
            }
            
            .portfolio-button {
                height: 60px;
            }
            
            .icon-container {
                width: 40px;
                height: 40px;
            }
        }
    </style>
</head>
<body>
    <div class="hero-section">
        <!-- Navigation -->
        <div class="nav-container">
            <!-- Mobile menu button -->
            <button id="mobile-menu-toggle" class="mobile-menu-button">☰</button>
            
            <!-- Rectangle logo avec bordure droite arrondie -->
            <div class="logo-container p-5">
                <img src="/assets/logo/VPI_Logo_black_background.png" alt="Vanilla Pay International" class="h-16 mx-auto">
            </div>
            
            <!-- Navigation items -->
            <div id="menu-container" class="menu-container p-12 border border-indigo-900/20">
                <div class="flex md:flex-row md:space-x-12 items-center">
                    <div class="text-white hover:text-blue-300 transition cursor-pointer px-4">ENTREPRISE</div>
                    <div class="bg-transparent border border-white rounded-full px-8 py-2 text-white hover:bg-white hover:text-purple-900 transition cursor-pointer">PARTICULIER</div>
                    <div class="text-white hover:text-blue-300 transition cursor-pointer px-4">RESSOURCE</div>
                    <!-- Langue selector -->
                    <div class="flex items-center space-x-3 text-white">
                        <span>LANGUE</span>
                        <div class="flex items-center space-x-2">
                            <img src="https://flagcdn.com/16x12/fr.png" alt="Français" class="w-6 h-4">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                            </svg>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Hero content -->
        <div class="px-4 md:px-10 pt-12 md:pt-24 flex flex-col items-start md:ml-20 hero-content">
            <div>
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight mb-12">
                    <div class="mb-5">SOLUTION INTERNATIONALE</div>
                    <div class="mb-5">DE PAIEMENT NUMÉRIQUE</div>
                    <div>POUR LES TOURISTES</div>
                </h1>

                <!-- Portfolio button avec icône arrondie -->
                <div class="inline-flex items-center justify-center bg-gray-200 hover:bg-white transition rounded-full cursor-pointer portfolio-button">
                    <span class="font-medium text-gray-800">Portfolio</span>
                    <div class="bg-black icon-container flex items-center justify-center ml-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // JavaScript pour le menu mobile
        const menuToggle = document.getElementById('mobile-menu-toggle');
        const menuContainer = document.getElementById('menu-container');
        
        menuToggle.addEventListener('click', function() {
            menuContainer.classList.toggle('active');
        });
    </script>
</body>
</html>